# Theme is generated by scripts/sync-theme.py from nvim/lua/palette.lua and
# linked to ~/.config/ghostty/themes by bootstrap.sh. Do not edit it by hand.
theme = oxocarbon-punch

font-family = "JetBrainsMono Nerd Font Mono"
font-size = 14
adjust-cell-height = 8%

window-padding-x = 10
window-padding-y = 10
cursor-style = block
mouse-hide-while-typing = true

# Deliberately `left`, not `true`. On the macOS German layout, Option is how
# you type [ ] { } | \ @ ~ — setting `true` sends both Option keys to the
# application as Alt and those characters become untypable. With `left`, the
# left Option acts as Alt for keybindings and the right Option still types
# punctuation.
macos-option-as-alt = left

# Reload this file. Ghostty's default is cmd+shift+, but punctuation keys are
# unreliable across layouts: on the German layout, shift and comma produces a
# semicolon, so the binding may never match. Letters are stable everywhere.
keybind = super+shift+r=reload_config

# Transparency is off by design. To enable it, uncomment both of these AND the
# ColorScheme block noted in nvim/lua/plugins/colorscheme.lua. They are a pair.
# background-opacity = 0.96
# background-blur = 20
